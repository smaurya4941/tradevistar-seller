# Copy to .env.development / .env.staging / .env.production. The real files are git-ignored.
# Android emulator reaches the host machine at 10.0.2.2; a USB device can use
# `adb reverse tcp:4000 tcp:4000` with http://localhost:4000 instead.
APP_ENV=development
API_BASE_URL=http://10.0.2.2:4000
SOCKET_URL=http://10.0.2.2:4000
# Seller web portal origin, used for App Links and "open on web" links.
WEB_URL=https://seller.tradevistar.com
# Google Maps SDK for Android key (address pin map). Empty hides the map option; GPS and "Find from address" still work.
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
# Usage analytics (Google Analytics 4 via Firebase). Default: off in development, on elsewhere.
ANALYTICS_ENABLED=false
SUPPORT_EMAIL=support@tradevistar.com
SUPPORT_PHONE=
SUPPORT_HOURS=Mon-Sat, 9:00 am to 6:00 pm IST
# Fallbacks used only until GET /app/config is available on the API.
MIN_SUPPORTED_VERSION=1.0.0
LATEST_VERSION=1.0.0
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.tradevistar.seller
# Legal and help pages opened from the app (default: WEB_URL/terms, /privacy, /help).
TERMS_URL=
PRIVACY_URL=
HELP_URL=
