{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "runtime.d.ts"],
  "exclude": ["src/**/__tests__/**"]
}
