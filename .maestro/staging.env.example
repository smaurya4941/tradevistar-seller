# Copy to .maestro/staging.env (git-ignored) or pass each value with -e in CI.
APP_ID=com.tradevistar.seller.staging
# An approved seller with a password and verified KYC.
SELLER_EMAIL=
SELLER_PASSWORD=

# -- Phase 1 (sign-in, registration, approval, invitations, notices) --------------
# SELLER_EMAIL / SELLER_PASSWORD above: an approved seller whose KYC is verified.
# Also: SELLER_MOBILE, the same seller's mobile number (OTP sign-in, flow 2).
SELLER_MOBILE=
# One-time code for the step that needs it. The API never returns codes: with
# OTP_DELIVERY_PROVIDER=console CI reads the latest code for the identifier from the backend log
# and passes it as -e OTP_CODE=... (the buyer app's scripts/e2e does the same). Flows that need
# two codes (7) use OTP_CODE_MOBILE / OTP_CODE_EMAIL, read after each "Get OTP".
OTP_CODE=
OTP_CODE_MOBILE=
OTP_CODE_EMAIL=
# Flow 3: an approved seller with two-factor sign-in on. Its second-factor code comes from the log.
TWO_FACTOR_EMAIL=
TWO_FACTOR_PASSWORD=
TWO_FACTOR_CODE=
# Flow 4: a seller whose approval is pending. Flow 5: one that was rejected, and the reason the
# admin typed (the screen must show it).
PENDING_EMAIL=
PENDING_PASSWORD=
REJECTED_EMAIL=
REJECTED_PASSWORD=
REJECTED_REASON=
# Flow 6: a buyer-only account (no seller role).
BUYER_ONLY_EMAIL=
BUYER_ONLY_PASSWORD=
# Flow 7: a fresh mobile (Indian, 10 digits) and email for every run, plus business details.
NEW_MOBILE=
NEW_EMAIL=
NEW_PASSWORD=Maestro#2026
NEW_COMPANY=Maestro Traders
NEW_GSTIN=27AAPFU0939F1ZV
# Flow 8: the seller whose password is reset, and the password it is reset to.
RESET_EMAIL=
RESET_NEW_PASSWORD=
# Flow 9: a real team-invitation token (the invitation email goes to the backend console in dev),
# and the email address it was sent to with that account's password.
INVITE_TOKEN=
INVITEE_EMAIL=
INVITEE_PASSWORD=
# Flow 10: an approved seller whose KYC is NOT verified.
UNVERIFIED_EMAIL=
UNVERIFIED_PASSWORD=
# Flow 11: a site notice for the seller audience created from the admin console (Maintenance and
# Notices), and its title.
NOTICE_TITLE=

# -- Phase 2 (Home, analytics, notifications, support, search, info pages) ------------
# API_URL: the staging API origin, used by scripts/staff-api.js (admin broadcasts, ticket replies).
API_URL=
# A unique value per run, so the titles the flows create (broadcasts, tickets) can be found again.
MAESTRO_RUN_ID=
# A staff account with marketing:manage and support:manage permissions.
ADMIN_IDENTIFIER=
ADMIN_PASSWORD=
# Two approved sellers with orders, inquiries, shipments, tickets and notifications seeded:
#   ANALYTICS_*: on a plan that includes Insights & Analytics (flows 1, 3, 12);
#   FREE_*: on the free plan, analytics locked (flow 2).
# SELLER_EMAIL / SELLER_PASSWORD above (verified KYC) is used by flows 4 to 10.
ANALYTICS_EMAIL=
ANALYTICS_PASSWORD=
FREE_EMAIL=
FREE_PASSWORD=
# Flow 6: the title of an unread order notification (a test order) for SELLER_EMAIL.
ORDER_NOTIFICATION_TITLE=
# Flow 9: the question of a published seller FAQ, and the title of a published seller announcement.
FAQ_QUESTION=
ANNOUNCEMENT_TITLE=
# Flow 10: a word that matches exactly one order of SELLER_EMAIL, and that order's number.
SEARCH_TERM=
ORDER_NUMBER=
# Flow 11: a footer page with the contact form switched on (Admin -> Footer), and the Terms page
# in the Legal column. The seller footer seeds help-support and terms-of-use.
HELP_PAGE_SLUG=help-support

# -- Phase 3 (profile, company, KYC and GST, bank, team, calendar, security) -------------
# The upload flows read PDFs from Downloads:  adb push .maestro/fixtures/. /sdcard/Download/
# The virus-scan setting must be the development one so uploads become clean.
# Flow 1: an approved seller with no KYC documents yet (KYC none).
UNVERIFIED_EMAIL=
UNVERIFIED_PASSWORD=
# Flow 2, 5, 6, 7, 8, 9, 10, 12: SELLER_EMAIL above (verified KYC documents, owner of the company).
# Flow 3: a seller with a saved GSTIN whose registry stub returns an email and a mobile. The two
# codes are read from the backend console log.
GST_OTP_EMAIL=
GST_OTP_PASSWORD=
GST_EMAIL_CODE=
GST_MOBILE_CODE=
# Flow 4: a seller whose GSTIN has no usable registered contacts (unsupported or missing).
GST_MANUAL_EMAIL=
GST_MANUAL_PASSWORD=
# Flow 5: an IFSC and account number the bank-verification stub accepts.
BANK_IFSC=HDFC0001234
BANK_ACCOUNT=123456789012
# Flow 8: an email address that is not on the team yet. Flow 9 needs one other active member.
TEAM_INVITEE_EMAIL=
# Flow 11: a seller with a verified email and two-factor off, and the codes from the log.
TWO_FACTOR_SELLER_EMAIL=
TWO_FACTOR_SELLER_PASSWORD=
TF_ON_CODE=
TF_OFF_CODE=
# Flow 13: a seller used only for the password change, and the password it becomes.
PASSWORD_SELLER_EMAIL=
PASSWORD_SELLER_PASSWORD=
NEW_PASSWORD_VALUE=Maestro#2027
# Flow 14: a seller whose login email changes, the new address, and the code sent to it.
CONTACT_SELLER_EMAIL=
CONTACT_SELLER_PASSWORD=
NEW_LOGIN_EMAIL=
CONTACT_CODE=
