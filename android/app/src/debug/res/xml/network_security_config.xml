<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain HTTP to a local API (emulator 10.0.2.2, or localhost through
  `adb reverse`) and Metro, plus user-installed CAs so a debugging proxy can inspect traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
