{
  "name": "tradevistar-seller",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=devDebug --appIdSuffix=dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appIdSuffix=staging",
    "android:prod": "react-native run-android --mode=prodDebug",
    "start": "react-native start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.js\"",
    "typecheck": "tsc --noEmit && tsc -p packages/seller-api/tsconfig.json",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "build:android:dev": "cd android && ./gradlew assembleDevDebug",
    "build:android:staging": "cd android && ./gradlew assembleStagingRelease",
    "build:android:prod": "cd android && ./gradlew bundleProdRelease"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.3",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "^8.30.0",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.104.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.25.1",
    "react-native-compressor": "^2.0.5",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^15.0.2",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-crop-picker": "^0.52.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-maps": "^1.29.11",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-nitro-sound": "^0.2.20",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
